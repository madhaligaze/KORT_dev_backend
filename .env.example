# API KORT (FastAPI). На Railway — переменные сервиса бэкенда.

# ── Обязательные ────────────────────────────────────────────────────────────
# База Postgres. На Railway: ${{Postgres.DATABASE_URL}}. Формат postgresql://
# принимается как есть — драйвер подставляется сам.
DATABASE_URL=postgresql://postgres:password@host:5432/railway
# production: cookie сессии только по HTTPS, и без базы приложение не
# поднимается (в development оно молча ушло бы на SQLite).
ENVIRONMENT=production
# Адрес фронта. Браузер ходит через прокси фронта, так что это страховка,
# а не рабочий путь.
ALLOWED_ORIGINS=https://kort.cards

# ── Нужны для части возможностей ────────────────────────────────────────────
# Сервисный аккаунт Google — JSON целиком одной строкой. Без него не работают
# «Книги Google» (перенос книг в учёт) и «Оплачено (сводка)» в реестре.
# В PDF-CONVERTER это значение лежало в BBC_SERVICE_ACCOUNT_JSON /
# WEBEXCEL_SERVICE_ACCOUNT_JSON — KORT читает только это имя.
FINANCE_SERVICE_ACCOUNT_JSON=
# Облачное распознавание сканов выписок. Пусто — локальный RapidOCR.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ── По желанию (значения по умолчанию) ─────────────────────────────────────
# FINANCE_ENABLED=true
# FINANCE_BASE_CURRENCY=KZT
# FINANCE_IMPORT_MAX_ROWS=20000
# FINANCE_IMPORT_MAX_MB=15
# FINANCE_GRID_MAX_ROWS=10000
# LOG_LEVEL=INFO
# APP_RELOAD=false
# PORT задаёт Railway.
