# API KORT (FastAPI). На Railway - переменные сервиса бэкенда.

# ── Обязательные ────────────────────────────────────────────────────────────
# База Postgres. На Railway: ${{Postgres.DATABASE_URL}}. Формат postgresql://
# принимается как есть - драйвер подставляется сам.
DATABASE_URL=postgresql://postgres:password@host:5432/railway
# production: cookie сессии только по HTTPS, и без базы приложение не
# поднимается (в development оно молча ушло бы на SQLite).
ENVIRONMENT=production
# Адрес фронта. Браузер ходит через прокси фронта, так что это страховка,
# а не рабочий путь.
ALLOWED_ORIGINS=https://kort.cards
# Общий секрет с прокси фронта. API верит адресу человека (x-client-ip)
# только у запроса с этим секретом в x-proxy-auth; прямой запрос к открытому
# API адрес подделать больше не может. То же значение - в PROXY_SHARED_SECRET
# фронта. Пусто (локальный запуск, тесты) - адресу верим как прежде.
PROXY_SHARED_SECRET=

# ── Нужны для части возможностей ────────────────────────────────────────────
# Сервисный аккаунт Google - JSON целиком одной строкой. Без него не работают
# «Книги Google» (перенос книг в учёт) и «Оплачено (сводка)» в реестре.
# Карточка счёта пишет «№ Счета» и дату в книги юрлиц, из которых собрана
# сводка: в этих книгах аккаунту нужно право редактора (у BBC есть с 22.10.2026).
# В PDF-CONVERTER это значение лежало в BBC_SERVICE_ACCOUNT_JSON /
# WEBEXCEL_SERVICE_ACCOUNT_JSON - KORT читает только это имя.
FINANCE_SERVICE_ACCOUNT_JSON=
# Облачное распознавание сканов выписок. Пусто - локальный RapidOCR.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Поддержка: бот Telegram (@kort_support_bot, токен - у @BotFather) и закрытый
# канал «KORT support», куда он кладёт обращения. Без них обращения копятся в
# базе и уйдут, когда бот появится. Токен - только у API прода: второй
# процесс с тем же токеном (локальный стенд) делил бы с продом ответы поддержки.
FINANCE_SUPPORT_BOT_TOKEN=
FINANCE_SUPPORT_CHAT_ID=-1004474041636
# Ключ шифрования паролей подключений к чужим системам (REST-сервис баз 1С в
# «Интеграции → 1С»): любая длинная случайная строка. Пусто - базу 1С не
# подключить. Сменили ключ - пароли баз вписываются заново.
FINANCE_SECRETS_KEY=
# Бот «Счета на оплату к выставлению» (@bbc_reminder_bot) и канал, куда он днём
# каждые несколько часов кладёт пост по книге-сводке (шаблон заказчика v1.3:
# абонентская плата и аренда в день «Периода с»), новое - сразу, в любое время,
# а по кнопке «Прислать сейчас» - тут же. Без них список живёт только в KORT.
# Токен - тоже только у API прода: локальный стенд со своей базой выложил бы в
# канал второй пост и перехватывал бы нажатия кнопки.
FINANCE_BILLS_BOT_TOKEN=
FINANCE_BILLS_CHAT_ID=@bbc_bills
# Адрес KORT для кнопки «Открыть в KORT» в посте.
FINANCE_APP_URL=https://kort.cards

# ── По желанию (значения по умолчанию) ─────────────────────────────────────
# FINANCE_ENABLED=true
# FINANCE_BASE_CURRENCY=KZT
# FINANCE_IMPORT_MAX_ROWS=20000
# FINANCE_IMPORT_MAX_MB=15
# FINANCE_GRID_MAX_ROWS=10000
# Как часто сервер сам перечитывает базы 1С, минут; 0 - только кнопкой «Обновить».
# FINANCE_ONEC_SYNC_MINUTES=30
# Бот счетов: первое напоминание (час по Астане, UTC+5), через сколько часов
# повторять до 20:00 (9, 11, 13, 15, 17, 19) и компания, чью книгу он читает (пусто -
# единственная с подключённой сводкой).
# FINANCE_BILLS_HOUR=9
# FINANCE_BILLS_EVERY=2
# FINANCE_BILLS_WORKSPACE_ID=
# LOG_LEVEL=INFO
# APP_RELOAD=false
# PORT задаёт Railway.
